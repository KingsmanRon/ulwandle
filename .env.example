# Copy to .env and fill. NEVER commit .env.
# Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required (no defaults) -----------------------------------------------
SECRET_KEY=__generate_a_48_char_random_string__
DATABASE_URL=postgresql://ulwandle:CHANGE_ME@db:5432/ulwandle_db
ANTHROPIC_API_KEY=sk-ant-api03-__YOUR_KEY__

# --- Production hardening -------------------------------------------------
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://your-frontend.vercel.app
TRUSTED_HOSTS=ulwandle-rac.fly.dev,api.ulwandle.tech

# --- Database / cache (compose defaults) ----------------------------------
POSTGRES_USER=ulwandle
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ulwandle_db
REDIS_URL=redis://redis:6379/0

# --- Kill switch (start disabled; enable explicitly per environment) ------
VALVE_CONTROL_ENABLED=false
DUAL_CONTROL_REQUIRED=true
PROPOSAL_TTL_SECONDS=600

# --- Sensor ingestion ------------------------------------------------------
SENSOR_INGEST_HMAC_REQUIRED=true
SENSOR_HMAC_TIMESTAMP_SKEW_SECONDS=120

# --- Rate limits ----------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_VALVE=20/hour

# --- Claude ---------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_DECISION_MODEL=claude-opus-4-7

# --- Frontend build arg ---------------------------------------------------
PUBLIC_API_URL=https://ulwandle-rac.fly.dev
