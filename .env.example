# Database Configuration
DATABASE_URL=postgresql://ulwandle:ulwandle_password@db:5432/ulwandle_db
POSTGRES_USER=ulwandle
POSTGRES_PASSWORD=ulwandle_password
POSTGRES_DB=ulwandle_db

# Claude AI Configuration (Optional - system works without it)
# Only required for AI-powered conservation recommendations
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Application Configuration
APP_ENV=development
APP_NAME=Ulwandle Tech
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Alert Configuration
ALERT_EMAIL=alerts@ulwandle.tech
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-provider.co.za/send

# Notification Configuration
# Used for shutdown notifications and system alerts
NOTIFICATION_WEBHOOK_URL=https://your-notification-service.com/webhook
EMPLOYEE_NOTIFICATION_ENABLED=True

# Blockchain Configuration
# SHA-256 blockchain hashing for data integrity
BLOCKCHAIN_ENABLED=True
BLOCKCHAIN_VERIFICATION_REQUIRED=False

# Redis Configuration (for caching and real-time)
REDIS_URL=redis://redis:6379/0

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ulwandle/app.log

# Metro Configuration
# Default water stress thresholds
WATER_STRESS_CRITICAL=40
WATER_STRESS_HIGH=30
WATER_STRESS_MEDIUM=20

# Export Configuration
EXCEL_EXPORT_ENABLED=True
MAX_METROS_PER_EXPORT=8
