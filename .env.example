# Database Configuration
DATABASE_URL=postgresql://ulwandle:ulwandle_password@db:5432/ulwandle_db
POSTGRES_USER=ulwandle
POSTGRES_PASSWORD=ulwandle_password
POSTGRES_DB=ulwandle_db

# Claude AI Configuration
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Application Configuration
APP_ENV=development
APP_NAME=Ulwandle Tech
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Alert Configuration
ALERT_EMAIL=alerts@ulwandle.tech
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-provider.co.za/send

# Water Quality Thresholds (SANS 241 Standards)
PH_MIN=6.0
PH_MAX=9.5
TDS_MAX=1200
TURBIDITY_MAX=5.0

# Leak Detection Thresholds
LEAK_THRESHOLD_PERCENT=15
ANOMALY_DETECTION_SENSITIVITY=0.85

# Kill Switch Configuration
VALVE_CONTROL_ENABLED=True
VALVE_TIMEOUT_SECONDS=30
REQUIRE_MANUAL_CONFIRMATION=True

# Notification Configuration
NOTIFICATION_WEBHOOK_URL=https://your-notification-service.com/webhook
EMPLOYEE_NOTIFICATION_ENABLED=True

# Redis Configuration (for caching and real-time)
REDIS_URL=redis://redis:6379/0

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ulwandle/app.log
